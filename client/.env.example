# Production API URL (The Railway Backend URL)
# Example: https://premium-store-production.up.railway.app
VITE_API_URL=

# Local Development default is http://localhost:5000 (auto-fallback if not set)

# Firebase (client) - set these in Netlify as environment variables
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (for unsigned client uploads)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# NOTE: For security, do NOT commit real API keys. Set these in your Netlify project settings.
